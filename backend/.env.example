# backend/.env.example — copier vers .env puis renseigner les secrets.
# cp .env.example .env

# --- Base de données ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestion_projet

# --- JWT ---
# En production, SECRET_KEY DOIT être définie (64 hex min.) :
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez_moi_avec_une_cle_longue_et_aleatoire
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- IA (fournisseur compatible OpenAI : groq | gemini | openai | ollama) ---
# Clé gratuite Groq : https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_API_KEY=gsk_changez_moi
LLM_BASE_URL=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_TIMEOUT_SECONDS=60

# --- Recherche sémantique (pgvector + embeddings locaux) ---
RECHERCHE_VECTORIELLE=true
EMBEDDING_MODEL=minishlab/potion-multilingual-128M
EMBEDDING_DIM=256
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_SEUIL=0.20
EMBEDDING_SEUIL_RELATIF=0.60

# --- Charge / surcharge / rappels ---
CHARGE_SEUIL_TACHES=5
CHARGE_SEUIL_RETARD=2
RAPPEL_ECHEANCE_JOURS=2

# --- Frontend (lien absolu reset password) ---
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30
RESET_LIEN_EN_REPONSE=true

# --- Email SMTP (obligatoire en production : APP_ENV=production refuse de démarrer sans SMTP_HOST) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
EMAIL_EXPEDITEUR=no-reply@i-rindra.com

# --- Besti (liaison désactivée tant que vide ; ne jamais logger ces secrets) ---
BESTI_URL=https://api-besti.bef4prod.com
BESTI_API_KEY=
BESTI_WEBHOOK_SECRET=

# --- Environnement : development | production | test ---
APP_ENV=development

# --- Compte admin initial (seed_admin.py : python seed_admin.py) ---
ADMIN_EMAIL=admin@i-rindra.mg
ADMIN_PASSWORD=Admin123!
ADMIN_NOM=Admin
ADMIN_PRENOM=Root
